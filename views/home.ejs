<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TomatoFlix</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 20px;
      background: #141414;
      color: white;
      font-family: Arial, sans-serif;
    }

    .navbar {
      background: #222;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 25px;
    }

    .navbar h1 {
      color: #fa5038;
      margin: 0 0 8px;
    }

    .navbar p {
      color: #ccc;
      margin: 0;
    }

    .container {
      max-width: 1100px;
      margin: auto;
      padding: 25px;
      background: #1e1e1e;
      border-radius: 12px;
    }

    #movieSearch {
      width: 100%;
      max-width: 400px;
      padding: 12px;
      margin-bottom: 25px;
      background: #292929;
      color: white;
      border: 1px solid #555;
      border-radius: 8px;
    }


    .movie-container {
      display: grid;
      grid-template-columns: repeat(auto-fit,
          minmax(200px, 1fr));
      gap: 24px;
      width: 100%;
    }


    .movie-card {
      width: 200px;
      background: #292929;
      border: 1px solid #444;
      border-radius: 10px;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.2s;
    }

    .movie-card:hover {
      transform: translateY(-5px);
    }


    .movie-card img {
      display: block;
      width: 100%;
      height: 280px;
      object-fit: cover;
      background: #292929;
    }


    .movie-info {
      padding: 15px;
    }

    .movie-info h3 {
      color: #fa5038;
    }

    .details-box {
      display: none;
      margin-top: 25px;
      padding: 20px;
      background: #292929;
      border: 1px solid tomato;
      border-radius: 10px;
    }

    .details-box h2 {
      color: tomato;
    }

    button {
      background: tomato;
      color: white;
      border: none;
      padding: 10px 15px;
      border-radius: 6px;
      cursor: pointer;
    }

    #genreFilter {
      padding: 12px;
      margin-bottom: 25px;
      background: #292929;
      color: white;
      border: 1px solid #555;
      border-radius: 8px;
      font-size: 15px;
      cursor: pointer;
    }

    #genreFilter,
    #languageFilter {
      padding: 12px 14px;
      margin-bottom: 25px;
      background: #292929;
      color: white;
      border: 1px solid #555;
      border-radius: 8px;
      font-size: 15px;
      cursor: pointer;
      outline: none;
    }

    #genreFilter:focus,
    #languageFilter:focus {
      border-color: tomato;
    }

    #genreFilter option,
    #languageFilter option {
      background: #292929;
      color: white;
    }


    * {
      box-sizing: border-box;
    }

    img {
      max-width: 100%;
    }

    /* Main content */
    .container {
      width: 100%;
      max-width: 1100px;
      margin: auto;
      padding: 25px;
    }

    /* Movie cards */
    .movie-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 24px;
      width: 100%;
    }

    .movie-card {
      width: 100%;
      min-width: 0;
    }

    .movie-card img {
      display: block;
      width: 100%;
      height: 280px;
      object-fit: cover;
    }

    /* Navbar links */
    .navbar nav {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 25px;
      margin-top: 15px;
    }

    .navbar nav a {
      color: #ffffff;
      text-decoration: none;
      font-size: 16px;
      font-weight: 600;
      padding: 10px 18px;
      border-radius: 8px;
      transition: all 0.3s ease;
    }

    /* Hover effect */
    .navbar nav a:hover {
      background-color: #e50914;
      color: #ffffff;
      transform: translateY(-2px);
    }

    /* Attractive Navbar Buttons */
    .navbar nav a {
      display: inline-block;
      padding: 12px 24px;
      margin: 0 5px;
      color: #ffffff;
      background: linear-gradient(135deg, #ff4b3e, #d90919);
      text-decoration: none;
      font-size: 15px;
      font-weight: bold;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 8px;
      box-shadow: 0 4px 12px rgba(229, 9, 20, 0.2);
      transition: all 0.3s ease;
    }

    /* Hover Animation */
    .navbar nav a:hover {
      background: linear-gradient(135deg, #ff6b5f, #ff1425);
      box-shadow: 0 0 20px rgba(255, 40, 40, 0.45);
      transform: translateY(-3px);
    }

    /* Click Effect */
    .navbar nav a:active {
      transform: scale(0.96);
    }

    /* Remove default link styling from movie cards */
    .movie-card .movie-link {
      display: block;
      color: inherit;
      text-decoration: none;
    }

    /* Movie title */
    .movie-card .movie-info h3 {
      color: #ff4b3e;
      text-decoration: none;
    }

    /* Year and rating */
    .movie-card .movie-info p {
      color: #ffffff;
      text-decoration: none;
    }

    /* Keep the same style when hovering or visiting */
    .movie-card .movie-link:visited,
    .movie-card .movie-link:hover,
    .movie-card .movie-link:active {
      color: inherit;
      text-decoration: none;
    }



    @media (max-width: 600px) {
      .movie-container {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }

      .navbar h1 {
        font-size: 26px;
      }

      .navbar nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
      }

      .movie-card img {
        width: 100%;
        height: auto;
      }
    }
  </style>
</head>

<body>

  <%- include('partials/navbar') %>

    <main class="container">
      <h2>Popular Movies</h2>



      <form action="/search" method="GET">
        <input type="text" id="movieSearch" name="q" placeholder="🔍 Search movies...">
        <button type="submit">Search</button>
      </form>




      <form id="genreForm">
        <select id="genreFilter" name="genre">
          <option value="all">All Genres</option>
          <option value="Action">Action</option>
          <option value="Sci-Fi">Sci-Fi</option>
          <option value="Drama">Drama</option>
          <option value="Romance">Romance</option>
          <option value="Thriller">Thriller</option>
          <option value="Comedy">Comedy</option>
        </select>

        <button type="submit">Filter</button>
      </form>



      <form id="languageForm">
        <select id="languageFilter" name="language">
          <option value="all">All Languages</option>
          <option value="English">English</option>
          <option value="Malayalam">Malayalam</option>
          <option value="Hindi">Hindi</option>
          <option value="Tamil">Tamil</option>
        </select>

        <button type="submit">Filter Language</button>
      </form>

      <% if (typeof searchQuery !=='undefined' && movies.length===0) { %>
        <p class="no-results">
          No movies found. Try another title!
        </p>
        <% } %>
          <div class="movie-container">

            <% movies.forEach(function(movie) { %>


              <div class="movie-card" data-genre="<%= movie.genre %>" data-language="<%= movie.language %>">
                <a href="/movies/<%= movie.id %>" class="movie-link">
                  <img src="<%= movie.poster %>" alt="<%= movie.title %>">

                  <div class="movie-info">
                    <h3>
                      <%= movie.title %>
                    </h3>
                    <p>Year: <%= movie.year %>
                    </p>
                    <p>Rating: <%= (movie.rating / 10).toFixed(1) %>/10</p>
                  </div>
                </a>
              </div>
              <% }); %>

          </div>

    </main>

    <script>
      const searchInput = document.getElementById('movieSearch');
      const movieCards = document.querySelectorAll('.movie-card');
      const genreFilter = document.getElementById('genreFilter');
      const languageFilter = document.getElementById('languageFilter');

      // Search + Genre + Language
      function filterMovies() {
        const searchText = searchInput.value.toLowerCase();
        const selectedGenre = genreFilter.value;
        const selectedLanguage = languageFilter.value;

        movieCards.forEach(function (card) {
          const title = card.querySelector('h3').textContent.toLowerCase();
          const genre = card.dataset.genre;
          const language = card.dataset.language;

          const matchesSearch = title.includes(searchText);

          const matchesGenre =
            selectedGenre === 'all' || genre === selectedGenre;

          const matchesLanguage =
            selectedLanguage === 'all' || language === selectedLanguage;

          if (matchesSearch && matchesGenre && matchesLanguage) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      }


      document.getElementById('genreForm').addEventListener('submit', function (event) {
        event.preventDefault();

        const genre = genreFilter.value;

        if (genre === 'all') {
          window.location.href = '/';
        } else {
          window.location.href = '/genre/' + encodeURIComponent(genre);
        }
      });


      document.getElementById('languageForm').addEventListener('submit', function (event) {
        event.preventDefault();

        const language = languageFilter.value;

        if (language === 'all') {
          window.location.href = '/';
        } else {
          window.location.href = '/language/' + encodeURIComponent(language);
        }
      });



    </script>

    <%- include('partials/footer') %>

</body>

</html>